# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CFO_CHAT_ID=your-cfo-chat-id

# Dodo Payments
# App-level API key for server-side Dodo API calls
DODO_API_KEY=your-dodo-api-key
DODO_BASE_URL=https://api.dodo.dev

# Express
PORT=3000
NODE_ENV=development

# Policy
AUTO_APPROVE_THRESHOLD_CENTS=50000
